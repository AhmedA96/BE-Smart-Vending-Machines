									"if ([200,201].includes(status)) {",
									"  const json = pm.response.json();",
									"  const firstMachine = json.machines && json.machines.length > 0 ? json.machines[0].id : null;",
									"  if (firstMachine) { pm.environment.set('machine_id', firstMachine); console.log('Saved machine_id:', firstMachine); }",
									"  pm.test('Nearby Machines Retrieved', function () { pm.expect(status).to.be.oneOf([200,201]); });",
									"} else {",
									"  pm.test(`Nearby Machines Failed (${status})`, function () { pm.expect.fail('Nearby Machines request failed'); });",
									"}"
								],
