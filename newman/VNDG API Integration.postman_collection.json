					"name": "Step 1 - Obtain Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const status = pm.response.code;",
									"console.log('Access Token Response Code:', status);",
									"console.log('Access Token Response Body:', pm.response.text());",
									"if ([200,201].includes(status)) {",
									"  const json = pm.response.json();",
									"  pm.environment.set('access_token', json.access_token);",
									"  pm.test('Access Token Retrieved', function () { pm.expect(status).to.be.oneOf([200,201]); });",
									"} else {",
									"  pm.test(`Access Token Failed (${status})`, function () { pm.expect.fail('Access token request failed'); });",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "password"
								},
								{
									"key": "mobile_number",
									"value": "{{phone}}"
								},
								{
									"key": "password",
									"value": "{{password}}"
								}
							]
						},
						"url": {
