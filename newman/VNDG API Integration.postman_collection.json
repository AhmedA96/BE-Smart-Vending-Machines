				{
					"name": "Step 7C - Make Payment via Backend",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const status = pm.response.code;",
									"console.log('Order Status Response Code:', status);",
									"console.log('Order Status Response Body:', pm.response.text());",
									"",
									"if ([200, 201].includes(status)) {",
									"    pm.test('Order Confirmed', function () { ",
									"        pm.expect(status).to.be.oneOf([200, 201]); ",
									"    });",
									"",
									"    const responseJson = pm.response.json();",
									"",
									"    // Set order_id env variable",
									"    if (responseJson.order && responseJson.order.id) {",
									"        pm.environment.set('order_id', responseJson.order.id);",
									"        console.log('order_id set to:', responseJson.order.id);",
									"    } else {",
									"        console.warn('order.id not found in response');",
									"    }",
									"",
									"    // Set payment_id env variable",
									"    if (responseJson.order && responseJson.order.payment && responseJson.order.payment.id) {",
									"        pm.environment.set('payment_id', responseJson.order.payment.id);",
									"        console.log('payment_id set to:', responseJson.order.payment.id);",
									"    } else {",
									"        console.warn('order.payment.id not found in response');",
									"    }",
									"",
									"    // Log if order is dispensed (check both status fields)",
									"    if (",
									"        responseJson.order &&",
									"        (responseJson.order.status === 'dispensed' || responseJson.order.dispense_status === 'dispensed')",
									"    ) {",
									"        console.log('Order has been dispensed');",
									"    }",
									"",
									"} else {",
									"    pm.test(`Order Confirmation Failed (${status})`, function () { ",
									"        pm.expect.fail('Order status request failed'); ",
									"    });",
