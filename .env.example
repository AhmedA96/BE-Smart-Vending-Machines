# ============================================
# AWS Configuration
# ============================================

# AWS region
AWS_REGION=me-south-1
AWS_DEFAULT_REGION=me-south-1

# AWS Profile for Terraform Deployment (recommended)
# Set up profile: aws configure --profile vndg
# Use profile: export AWS_PROFILE=vndg
# Then run: terraform plan
AWS_PROFILE=vndg

# Alternative: Set credentials directly (not recommended)
# Get these from AWS IAM Console: https://console.aws.amazon.com/iam/
# DO NOT commit actual credentials to git
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================================
# AWS Secrets Manager Configuration
# ============================================

# Set to 'true' to load secrets from AWS Secrets Manager (production/staging)
AWS_LOAD_SECRETS=false

# Project name used in secret paths
SECRETS_PROJECT=vending-system

# ============================================
# Database Configuration
# ============================================
# When using AWS Secrets Manager, these are loaded automatically
# For local development, set these manually or use Secrets Manager

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vndgme_development

# Legacy database env vars (fallback)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# Redis Configuration
# ============================================
# When using AWS Secrets Manager, these are loaded automatically
# For local development, set these manually or use Secrets Manager

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ============================================
# Application Secrets
# ============================================
# These should NEVER be committed to git
# For production, these are loaded from AWS Secrets Manager
# For local development, generate these locally

# Rails master key for encrypted credentials
RAILS_MASTER_KEY=

# Rails secret key base for session signing
SECRET_KEY_BASE=

# JWT secret for API token signing
JWT_SECRET=

# ============================================
# Third-party API Keys
# ============================================
# For production, these are loaded from AWS Secrets Manager
# For local development, set these if needed for testing

# Payment provider
PAYMENT_PROVIDER_KEY=

# SMS provider
SMS_PROVIDER_KEY=

# ============================================
# Rails Configuration
# ============================================

RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# ============================================
# Application Configuration
# ============================================

# Domain name
DOMAIN_NAME=localhost:3000

# Timezone
TZ=Asia/Dubai

# ============================================
# Terraform Deployment
# ============================================
# These environment variables are used when deploying infrastructure with Terraform
#
# Before deploying:
#   1. Get AWS credentials from IAM Console
#   2. Set these in your .env file (never commit to git)
#   3. Run: terraform plan
#
# Usage:
#   export $(cat .env | grep AWS | xargs)
#   cd terraform
#   terraform plan -out=tfplan
#   terraform apply tfplan
#
# See: /terraform/terraform.tfvars.example for infrastructure variables
