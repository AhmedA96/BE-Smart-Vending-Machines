<div class="auth-wrapper">
  <div class="auth-card">
    <div class="logo-wrapper">
      <%= image_tag "logo.svg", alt: "Company Logo", class: "img-fluid" %>
    </div>
    
    <h2 class="card-title">Reset Password</h2>
    
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-floating mb-3">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "name@example.com" %>
        <%= f.label :email %>
      </div>

      <%= f.submit "Send Reset Instructions", class: "btn btn-primary" %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    <% end %>
  </div>
</div>
