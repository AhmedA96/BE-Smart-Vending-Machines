<div class="auth-wrapper">
  <div class="auth-card">
    <div class="logo-wrapper">
      <%= image_tag "logo.svg", alt: "Company Logo", class: "img-fluid" %>
    </div>

    <h2 class="card-title"><%= t('devise.passwords.edit.title') %></h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="form-floating mb-3">
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: t('devise.passwords.edit.new_password') %>
        <%= f.label :password, t('devise.passwords.edit.new_password') %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: t('devise.passwords.edit.confirm_new_password') %>
        <%= f.label :password_confirmation, t('devise.passwords.edit.confirm_new_password') %>
      </div>

      <%= f.submit t('devise.passwords.edit.change_password'), class: "btn btn-primary" %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    <% end %>
  </div>
</div>
