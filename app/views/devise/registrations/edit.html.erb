<div class="card">
  <div class="card-body">
    <div class="auth-logo-box">
      <%= image_tag "logo.svg", class: "auth-logo" %>
    </div>

    <h2 class="card-title"><%= t('devise.registrations.edit.title', resource: resource_name.to_s.humanize) %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-floating mb-3">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: t('devise.registrations.edit.email') %>
        <%= f.label :email, t('devise.registrations.edit.email') %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert alert-info">
          <%= t('devise.registrations.edit.waiting_confirmation', email: resource.unconfirmed_email) %>
        </div>
      <% end %>

      <div class="form-floating mb-3">
        <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: t('devise.registrations.edit.password') %>
        <%= f.label :password, t('devise.registrations.edit.password') %>
        <small class="form-text text-muted">
          <%= t('devise.registrations.edit.leave_blank') %>
        </small>
        <% if @minimum_password_length %>
          <small class="form-text text-muted">
            <%= t('devise.registrations.edit.min_chars', count: @minimum_password_length) %>
          </small>
        <% end %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: t('devise.registrations.edit.password_confirmation') %>
        <%= f.label :password_confirmation, t('devise.registrations.edit.password_confirmation') %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control", placeholder: t('devise.registrations.edit.current_password') %>
        <%= f.label :current_password, t('devise.registrations.edit.current_password') %>
        <small class="form-text text-muted">
          <%= t('devise.registrations.edit.current_password_note') %>
        </small>
      </div>

      <%= f.submit t('devise.registrations.edit.update'), class: "btn btn-primary" %>
    <% end %>

    <div class="mt-3">
      <h3><%= t('devise.registrations.edit.cancel_account') %></h3>
      <p><%= t('devise.registrations.edit.unhappy') %></p>
      <%= button_to t('devise.registrations.edit.cancel_my_account'), registration_path(resource_name),
                    data: { confirm: t('devise.registrations.edit.confirm_cancel') },
                    method: :delete,
                    class: "btn btn-danger" %>
    </div>

    <div class="auth-links mt-3">
      <%= link_to t('devise.shared.links.back'), :back %>
    </div>
  </div>
</div>
