# Sample environment variables for VNDG-ME deployment
# Copy this file to .env and fill in the actual values
# DO NOT commit this file with real values to git!

# Registry credentials
KAMAL_REGISTRY_PASSWORD=your_github_token_here

# Database configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis configuration  
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@192.168.0.2:6379/0

# Rails configuration (generate with: bin/rails secret)
RAILS_MASTER_KEY=your_rails_master_key_here

# Optional: Additional secrets you might need
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# STORAGE_BUCKET=your-s3-bucket-name

# Email configuration (if using SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Notification services
# FCM_SERVER_KEY=your_fcm_server_key
# CEQUENS_API_KEY=your_cequens_api_key
# CEQUENS_USERNAME=your_cequens_username
# CEQUENS_PASSWORD=your_cequens_password

# New Relic (monitoring)
# NEW_RELIC_LICENSE_KEY=your_newrelic_license_key
# NEW_RELIC_APP_NAME=VNDG-ME-Production

# Google APIs (for Drive integration)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
