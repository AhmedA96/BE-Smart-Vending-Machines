# Staging Secrets for Kamal
# ==========================
# These secrets are sourced from .env file for staging deployment
# In production, use AWS Secrets Manager (see .kamal/secrets.production)

# Source variables from .env file
set -a
source "$(dirname "$0")/../.env.staging"
set +a

# Database configuration
POSTGRES_USER=${POSTGRES_USER:-vndg}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-}

# Rails master key
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-}

# Container registry password
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:-}
