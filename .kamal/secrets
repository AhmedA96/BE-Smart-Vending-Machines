# Development/Local Secrets for Kamal
# ====================================
# These secrets are sourced from .env file for local development
# In production, use AWS Secrets Manager (see .kamal/secrets.production)

# Source variables from .env file
set -a
source "$(dirname "$0")/../.env"
set +a

# Database configuration
POSTGRES_USER=${POSTGRES_USER:-vndg}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-vndgme}

# Rails master key (read from config/master.key if not in .env)
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:-$(cat config/master.key 2>/dev/null || echo "")}

# Container registry password
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:-}
