# Kamal Production Secrets for AWS Infrastructure
# ================================================
# This file retrieves secrets from AWS Secrets Manager instead of hardcoding them.
# Secrets are created and managed by Terraform in terraform/environments/production/secrets.tf

# ==============================================================================
# Container Registry Authentication
# ==============================================================================
# GitHub Container Registry token fetched from AWS Secrets Manager
KAMAL_REGISTRY_PASSWORD=$(aws secretsmanager get-secret-value \
  --secret-id vending-system/production/github-container-registry-token \
  --region me-central-1 \
  --query SecretString \
  --output text 2>/dev/null)

# ==============================================================================
# Database Secrets (Retrieved from AWS Secrets Manager)
# ==============================================================================
# Database credentials are stored in AWS Secrets Manager by Terraform
# and automatically injected via the secrets_manager.rb initializer

POSTGRES_USER=$(aws secretsmanager get-secret-value \
  --secret-id vending-system/production/db/credentials \
  --region me-central-1 \
  --query 'SecretString' \
  --output text 2>/dev/null | jq -r '.username // empty')

POSTGRES_PASSWORD=$(aws secretsmanager get-secret-value \
  --secret-id vending-system/production/db/credentials \
  --region me-central-1 \
  --query 'SecretString' \
  --output text 2>/dev/null | jq -r '.password // empty')

# ==============================================================================
# Rails Master Key (Retrieved from AWS Secrets Manager)
# ==============================================================================
# Rails master key is fetched from app/secrets container in AWS Secrets Manager

RAILS_MASTER_KEY=$(aws secretsmanager get-secret-value \
  --secret-id vending-system/production/app/secrets \
  --region me-central-1 \
  --query 'SecretString' \
  --output text 2>/dev/null | jq -r '.rails_master_key // empty')
