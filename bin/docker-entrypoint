#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server, optionally run db:prepare (can be slow/unsafe on shared DBs)
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  if [ "${RUN_DB_PREPARE_ON_BOOT:-false}" = "true" ]; then
    ./bin/rails db:prepare
  else
    echo "Skipping db:prepare on boot (set RUN_DB_PREPARE_ON_BOOT=true to enable)"
  fi
fi

exec "${@}"
